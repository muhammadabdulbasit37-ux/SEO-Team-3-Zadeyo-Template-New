---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { useLocale } from '../i18n';
import { linkifyMarkdown } from '../utils/linkify';
import { localizeInlineHtmlLinks } from '../utils/localizeHtmlLinks';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
const { locale, t, lp } = useLocale(Astro.currentLocale);
---

<article class="py-8 md:py-12">
  <div class="site-container">
    <Breadcrumbs
      items={[
        { name: t.common.breadcrumbHome, path: '/' },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    <div class="mt-6">
      <SectionHeader title={title} desc={description} level="h1" />
    </div>

    <Prose class="mt-8 max-w-3xl text-left">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p set:html={localizeInlineHtmlLinks(linkifyMarkdown(paragraph), locale)} />
          ))}
        </section>
      ))}
      <slot />
    </Prose>

    <div class="mt-10 flex max-w-3xl flex-wrap gap-3 border-t border-border pt-6">
      <Button as="a" href={lp('/support/')} variant="primary" size="sm">
        {t.common.contactSupport}
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={lp('/')} variant="outline" size="sm">{t.notFound.backHome}</Button>
    </div>
  </div>
</article>
