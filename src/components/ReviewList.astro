---
import { reviewCopy, type reviews } from '../data/reviews';
import { useLocale } from '../i18n';

interface Props {
  entries: readonly (typeof reviews)[number][];
  productLinks?: Readonly<Record<string, string>>;
}

const { entries, productLinks } = Astro.props;
const { locale, lp } = useLocale(Astro.currentLocale);
const copy = reviewCopy[locale];
const formatDate = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' });
---

<ul class="mt-6 list-none divide-y divide-border border-y border-border p-0" role="list">
  {entries.map((review) => (
    <li data-review-row class="py-6 md:py-8">
      <article lang="en" class="grid gap-4 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
        <div class="min-w-0 space-y-1.5 text-sm">
          {productLinks?.[review.product] && (
            <a href={lp(productLinks[review.product])} class="inline-flex min-h-7 items-center font-medium text-primary-text underline underline-offset-4 hover:text-foreground">
              {review.product}
            </a>
          )}
          <p class="break-words font-semibold text-foreground">{review.author}</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 md:flex-col md:items-start">
            <time datetime={review.date} lang={locale} class="text-xs text-muted-foreground">{formatDate.format(new Date(review.date))}</time>
            <span role="img" aria-label={`${review.rating} ${copy.rating}`} lang={locale} class="whitespace-nowrap tracking-wider text-primary-text">
              <span aria-hidden="true">{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</span>
            </span>
          </div>
        </div>
        <div class="min-w-0 max-w-[72ch]">
          <h3 class="font-[family-name:var(--font-heading)] text-lg font-semibold leading-snug text-foreground md:text-xl">{review.title}</h3>
          <blockquote class="mt-3 space-y-3 text-sm leading-relaxed text-muted-foreground">
            {review.text.split(/\n\s*\n/).map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
          </blockquote>
        </div>
      </article>
    </li>
  ))}
</ul>
