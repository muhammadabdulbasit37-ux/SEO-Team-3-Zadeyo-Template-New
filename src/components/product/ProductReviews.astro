---
import { getProductReviewSummary, reviewCopy } from '../../data/reviews';
import { useLocale } from '../../i18n';
import { ROUTES } from '../../utils/path';
import Icon from '../icons/Icon.astro';
import ReviewList from '../ReviewList.astro';
import SectionHeader from '../SectionHeader.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  sku: string;
}

const { locale, lp } = useLocale(Astro.currentLocale);
const copy = reviewCopy[locale];
const { entries, count, average } = getProductReviewSummary(Astro.props.sku);
const formattedAverage = new Intl.NumberFormat(locale).format(average);
---

{count > 0 && (
  <section class="border-t border-border py-12 md:py-16" aria-labelledby="product-reviews">
    <div class="site-container">
      <SectionHeader eyebrow={copy.label} title={copy.heading} titleId="product-reviews" start />
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
        <strong class="font-semibold text-foreground">{formattedAverage} {copy.rating}</strong>
        <span>{count} {copy.count}</span>
      </p>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.note}</p>
      <ReviewList entries={entries} />
      <Button as="a" href={lp(ROUTES.reviews)} variant="outline" class="mt-6 rounded-xl">
        {copy.nav}
        <Icon name="arrowRight" size={16} />
      </Button>
    </div>
  </section>
)}
