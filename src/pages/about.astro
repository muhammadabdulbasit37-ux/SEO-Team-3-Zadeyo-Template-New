---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useLocale } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';
import { editorialGuidance } from '../data/editorialGuidance';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const seo = resolvePageSeo('/about/', locale);
const content = t.legalPages.about;
const overview = editorialGuidance[locale];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(locale),
    webPageSchema({
      name: content.title,
      description: content.description,
      url: lp('/about/'),
      locale,
    }),
    breadcrumbSchema([
      { name: t.common.breadcrumbHome, path: '/' },
      { name: t.common.breadcrumbAbout, path: '/about/' },
    ], locale),
  ]}
>
  <LegalPage
    title={content.title}
    description={content.description}
    breadcrumbLabel={t.common.breadcrumbAbout}
    sections={content.sections}
  />
  <p class="mx-auto max-w-3xl px-5 pb-12 text-sm leading-relaxed text-muted-foreground">{overview.overviewIntro}{' '}<a class="text-primary underline underline-offset-4" href={lp('/')}>{overview.overviewAnchor}</a>{overview.overviewEnding}</p>
</BaseLayout>
