---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewList from '../components/ReviewList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { useLocale } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { reviews, reviewCopy } from '../data/reviews';
import { getCatalog } from '../data/catalog';
import { ROUTES } from '../utils/path';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const copy = reviewCopy[locale];
const contextHeading = { en: 'Before you choose', es: 'Antes de elegir', de: 'Vor deiner Wahl', fr: 'Avant de choisir' }[locale];
const seo = resolvePageSeo(ROUTES.reviews, locale);
const catalog = getCatalog(locale);
const breadcrumbs = [{ name: t.common.breadcrumbHome, path: '/' }, { name: copy.label, path: ROUTES.reviews }];
const productLinks = {
  'The Isle Cheats': ROUTES.productsElite,
  'HWID Spoofer': ROUTES.hwidSpoofer,
  'Skin Changer': ROUTES.skinChanger,
  UGC: ROUTES.ugc,
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={lp(ROUTES.reviews)}
  jsonLd={[
    webPageSchema({ name: copy.title, description: copy.intro, url: lp(ROUTES.reviews), locale }),
    breadcrumbSchema(breadcrumbs, locale),
  ]}
>
  <section class="border-b border-border bg-muted/10 pb-8 md:pb-12" aria-labelledby="reviews-page-title">
    <div class="site-container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader eyebrow={t.site.name} title={copy.title} desc={copy.intro} titleId="reviews-page-title" level="h1" />
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        <span>{reviews.length} {copy.count}</span>
        <span class="inline-flex items-center gap-2">
          <Icon name="shieldCheck" size={15} />
          {copy.closed}
        </span>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16" aria-labelledby="reviews-heading">
    <div class="site-container">
      <SectionHeader title={copy.heading} desc={copy.description} titleId="reviews-heading" start />
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.note}</p>
      <ReviewList entries={reviews} productLinks={productLinks} />
    </div>
  </section>

  <section class="border-t border-border bg-muted/10 py-12 md:py-16" aria-labelledby="reviews-context-title">
    <div class="site-container">
      <SectionHeader title={contextHeading} desc={copy.context} titleId="reviews-context-title" start />
      <ul class="mt-6 list-none divide-y divide-border border-y border-border p-0">
        {catalog.map((product) => (
          <li class="grid items-start gap-2 py-4 text-sm leading-relaxed md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
            <a class="font-medium text-primary-text underline underline-offset-4 hover:text-foreground" href={lp(product.path)}>{product.shortName}</a>
            <p class="max-w-[72ch] text-muted-foreground">{product.page.desc}</p>
          </li>
        ))}
      </ul>
      <Button as="a" href={lp(ROUTES.productsElite)} variant="primary" class="mt-6 rounded-xl">
        {copy.cta}
        <Icon name="arrowRight" size={16} />
      </Button>
    </div>
  </section>
</BaseLayout>
