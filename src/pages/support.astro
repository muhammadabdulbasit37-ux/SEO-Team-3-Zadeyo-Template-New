---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useLocale } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const seo = resolvePageSeo('/support/', locale);
const breadcrumbs = [
  { name: t.common.breadcrumbHome, path: '/' },
  { name: t.common.breadcrumbSupport, path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: lp('/support/'),
      locale,
    }),
    breadcrumbSchema(breadcrumbs, locale),
  ]}
>
  <ContactSupportSection titleId="support-page-title" breadcrumbs={breadcrumbs} showTicketTips />
</BaseLayout>
